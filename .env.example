# Copy to .env (or .env.local) and fill in real values. Never commit the real file.

# ---------- Database (either DATABASE_URL or DB_* fields) ----------
DATABASE_URL=postgresql://postgres:password@localhost:5432/yolohome_db
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=yolohome_db
# DB_USER=postgres
# DB_PASSWORD=
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=false

# ---------- Adafruit IO ----------
AIO_USERNAME=your_adafruit_username
AIO_KEY=your_adafruit_key
# Required for /api/webhooks/adafruit (pass as ?secret=... or x-webhook-secret header)
ADAFRUIT_WEBHOOK_SECRET=change-me-long-random-string

# ---------- Face AI ----------
# Shared secret between Next.js and the Python face service (x-face-api-key header)
FACE_API_SECRET=change-me-long-random-string
# Next.js /api/faces/identify threshold (Euclidean distance, lower = stricter)
FACE_MATCH_THRESHOLD=0.85
# FastAPI /api/recognize threshold
FACE_MATCH_THRESHOLD_FASTAPI=0.6
# Comma-separated CORS origins allowed to call the FastAPI server
FACEAI_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Used by ml/face_recognition_service.py
FACE_API_URL=http://localhost:3000
CAMERA_URL=0
STREAM_PORT=5001

# Browser-side URLs (baked in at build time)
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8000
NEXT_PUBLIC_STREAM_URL=http://localhost:5001

# ---------- Auth / cookies ----------
# Session cookie gets the Secure flag in production. Set to false only for plain-HTTP LAN demos.
# COOKIE_SECURE=true

# ---------- Email (password reset): Resend OR SMTP ----------
APP_BASE_URL=http://localhost:3000
MAIL_FROM="YoloHome <no-reply@example.com>"
# RESEND_API_KEY=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
